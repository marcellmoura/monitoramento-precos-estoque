# Compose le .env na raiz.
APP_PORT=5173

# Exportar apenas se rodar o backend diretamente no host.
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1

# Banco local: preencher uma senha exclusiva antes de iniciar.
DB_NAME=monitoramento
DB_USER=monitoramento
DB_PASSWORD=
DB_PORT=5432

# Ativar ao servir por HTTPS; false somente para HTTP local.
SESSION_COOKIE_SECURE=false

# Upload de PDFs. Os limites de transporte devem superar o limite funcional.
# Caminho usado apenas quando o backend roda diretamente no host.
IMPORTACAO_PASTA=storage/importacoes
IMPORTACAO_LIMITE_BYTES=10485760
IMPORTACAO_LIMITE_PAGINAS=50
IMPORTACAO_LIMITE_TRANSPORTE_ARQUIVO=12MB
IMPORTACAO_LIMITE_TRANSPORTE_REQUISICAO=13MB

# Extração em segundo plano.
IMPORTACAO_PROCESSAMENTO_ATIVO=true
IMPORTACAO_INTERVALO_EXTRACAO_MS=2000
IMPORTACAO_PRAZO_EXTRACAO_SEGUNDOS=120
IMPORTACAO_FUSO_COMERCIAL=America/Fortaleza
